{
  "manifest_version": 3,
  "name": "DZMM 搜索增强版",
  "short_name": "DZMM 搜索",
  "version": "1.1.0",
  "description": "为 DZMM 提供更聪明的搜索：多关键词、标签/作者定向、赞数/评分过滤，支持直接按作者名查看 TA 的卡片。",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 DZMM 搜索增强版"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dzmm.ai/*",
        "https://dzmm.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.dzmm.ai/*",
    "https://dzmm.ai/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "search.html",
        "competition.html",
        "app.js",
        "competition.js",
        "style.css"
      ],
      "matches": [
        "https://www.dzmm.ai/*",
        "https://dzmm.ai/*"
      ]
    }
  ]
}
